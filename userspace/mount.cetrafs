#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-or-later
#
# mount.cetrafs -- mount(8)'s helper for -t cetrafs: a preflight, then
# the mount itself (mount -i, so this helper is not called again).
#
#   mount.cetrafs <device> <dir> [-sfnvNi] [-o <options>]
#
# What it checks: how long dm-multipath may hold this node's writes back.
# A node that loses its paths self-fences when its lease runs out (the
# stale window less one heartbeat, 105 s by default) and its peers then
# take over its Zone Groups and allocate in them. Writes already
# submitted are not recalled: a multipath map that queues while no path
# is up hands them to the array when the paths return -- bitmap, extent
# leaf, journal and record writes aimed at blocks a peer now owns, which
# is double allocation with a clean fsck at every moment before it
# (audit 2026-11-14 A-6). So a map whose queueing can outlast the lease
# is refused:
#   - queue_if_no_path with no_path_retry "queue" (never gives up), or
#     with multipathd not there to say what bounds it;
#   - no_path_retry N with N x polling_interval longer than the lease.
# no_path_retry "fail"/"off", or N short enough, mounts.
#
# And before any of that, a path holds a write for as long as its
# transport waits for it: the SCSI command timeout, plus an iSCSI
# session's recovery_tmo (replacement_timeout) or an FC port's
# fast_io_fail_tmo (dev_loss_tmo when that is off). A single-path device
# whose hold outlasts the lease is refused like a queueing map, and a
# map's bound is its slowest path's hold PLUS its queueing (audit
# 2026-11-15 B-20: the default replacement_timeout, 120 s, is the stale
# window itself).
#
# -o x-cetrafs.mpath-queue-ok (or x-cetrafs.queue-ok) mounts such a
# device anyway, with a warning --
# for a cluster fenced in hardware (SCSI-3 reservations, power), where
# a fenced node's queued writes are refused by the array or never sent.
#
# Exit status: as mount(8) -- 32 for a refused mount.
set -u

warn() { echo "mount.cetrafs: $*" >&2; }

[ $# -ge 2 ] || { warn "usage: mount.cetrafs <device> <dir> [-sfnvN] [-o options]"; exit 1; }
dev=$1
dir=$2
shift 2

opts=""
args=""
override=0
while [ $# -gt 0 ]; do
    case "$1" in
    -o)
        [ $# -ge 2 ] || { warn "-o needs an argument"; exit 1; }
        opts=$2
        shift 2
        ;;
    -t)
        shift 2 # always cetrafs
        ;;
    *)
        args="$args $1"
        shift
        ;;
    esac
done

# Our own option never reaches the kernel.
kept=""
oldifs=$IFS
IFS=,
for o in $opts; do
    if [ "$o" = "x-cetrafs.mpath-queue-ok" ] || [ "$o" = "x-cetrafs.queue-ok" ]; then
        override=1
    else
        kept="${kept:+$kept,}$o"
    fi
done
IFS=$oldifs

# The lease, from the module's timing: the stale window less one
# heartbeat. Loaded first, so options set in modprobe.d count -- before
# that, the parameters are not there and only the built-in defaults were.
[ -d /sys/module/cetrafs/parameters ] || modprobe -q cetrafs 2>/dev/null || true
param() { cat "/sys/module/cetrafs/parameters/$1" 2>/dev/null || echo "$2"; }
stale=$(param stale_secs 120)
hb=$(param hb_interval_secs 15)
lease=$((stale - hb))

# Where sysfs is: a suite stages a fake tree under CETRAFS_SYSFS.
SYS=${CETRAFS_SYSFS:-/sys}
num() { case "${1:-}" in '' | *[!0-9]*) echo 0 ;; *) echo "$1" ;; esac; }

# path_hold <disk>: $hold, the seconds a write can sit on this SCSI path
# before it fails back to us (0 when it is not a SCSI disk), and $why.
path_hold() {
    d=$1
    why=""
    hold=0
    # TEST ONLY: the hold left out, as before (mount_helper_transport_hold.sh)
    [ -z "${CETRAFS_TEST_NO_TRANSPORT_HOLD:-}" ] || return 0
    [ -e "$SYS/block/$d/device" ] || return 0
    t=$(num "$(cat "$SYS/block/$d/device/timeout" 2>/dev/null)")
    p=$(readlink -f "$SYS/block/$d/device" 2>/dev/null || true)
    x=0
    s=$(echo "$p" | grep -o 'session[0-9]*' | head -1)
    r=$(echo "$p" | grep -o 'rport-[0-9:-]*' | head -1)
    if [ -n "$s" ] && [ -r "$SYS/class/iscsi_session/$s/recovery_tmo" ]; then
        x=$(num "$(cat "$SYS/class/iscsi_session/$s/recovery_tmo")")
        why="iSCSI $s recovery_tmo ${x}s"
    elif [ -n "$r" ] && [ -d "$SYS/class/fc_remote_ports/$r" ]; then
        f=$(cat "$SYS/class/fc_remote_ports/$r/fast_io_fail_tmo" 2>/dev/null || echo off)
        case "$f" in
        '' | *[!0-9]*)
            x=$(num "$(cat "$SYS/class/fc_remote_ports/$r/dev_loss_tmo" 2>/dev/null)")
            why="FC $r dev_loss_tmo ${x}s (fast_io_fail_tmo off)"
            ;;
        *)
            x=$f
            why="FC $r fast_io_fail_tmo ${x}s"
            ;;
        esac
    fi
    why="SCSI timeout ${t}s${why:+ + $why}"
    hold=$((t + x))
}

# The longest hold of any path under a dm map (from its table's devices).
detect=0
detect_why=""
map_hold() {
    detect=0
    detect_why=""
    for mm in $(echo "$1" | grep -o '[0-9][0-9]*:[0-9][0-9]*'); do
        d=$(readlink -f "$SYS/dev/block/$mm" 2>/dev/null || true)
        d=${d##*/}
        [ -n "$d" ] || continue
        path_hold "$d"
        if [ "$hold" -gt "$detect" ]; then
            detect=$hold
            detect_why="$d: $why"
        fi
    done
}

# mpath_check <dm name> -> 0 mountable, 1 refused (reason on stderr)
mpath_check() {
    map=$1
    table=$(dmsetup table "$map" 2>/dev/null) || { warn "$dev: cannot read the multipath table of $map"; return 1; }
    # "<start> <len> multipath <#features> <feature>... ": queueing is the
    # queue_if_no_path feature
    feats=$(echo "$table" | awk '{ for (i = 1; i <= NF; i++) if ($i == "multipath") { n = $(i + 1); s = ""; for (j = 1; j <= n; j++) s = s " " $(i + 1 + j); print s; exit } }')
    map_hold "$table"
    case " $feats " in
    *" queue_if_no_path "*) ;;
    *)
        # fails I/O at once when no path is up -- once its paths have
        # failed it back, which takes their hold
        [ "$detect" -le "$lease" ] && return 0
        warn "$dev: a path of multipath map $map holds a write for up to ${detect}s ($detect_why) before"
        warn "  failing it, longer than this node's lease (${lease}s): it can reach the array after a peer has"
        warn "  taken over the blocks it was aimed at. Lower the transport timeouts."
        return 1
        ;;
    esac
    q=""
    poll=5
    if command -v multipathd >/dev/null 2>&1; then
        q=$(multipathd show maps raw format "%n|%Q" 2>/dev/null | awk -F'|' -v m="$map" '$1 == m { print $2; exit }')
        p=$(multipathd show config 2>/dev/null | awk '$1 == "polling_interval" { print $2; exit }')
        case "$p" in '' | *[!0-9]*) ;; *) poll=$p ;; esac
    fi
    set -- $q
    # "-" is multipathd's "not set" -- and the table above already says
    # the map queues, so not set is no bound at all, not "fails at once".
    case "${1:-}" in
    off | fail)
        return 0
        ;;
    '' | *[!0-9]*)
        warn "$dev: multipath map $map queues writes while no path is up${q:+ (no_path_retry: $q)}, with no limit"
        warn "  this node can see -- they can reach the array after this node's lease (${lease}s) has run out"
        warn "  and a peer owns the blocks they were aimed at. Set no_path_retry to fail, or to a count with"
        warn "  count x polling_interval (${poll}s) under ${lease}s, in multipath.conf."
        return 1
        ;;
    esac
    bound=$(($1 * poll + detect))
    [ "$bound" -le "$lease" ] && return 0
    warn "$dev: multipath map $map queues writes for up to ${bound}s with no path up (no_path_retry $1 x"
    warn "  polling_interval ${poll}s${detect_why:+, after up to ${detect}s for a path to fail them: $detect_why}),"
    warn "  longer than this node's lease (${lease}s): they can reach the array after a peer has taken over"
    warn "  the blocks they were aimed at. Lower no_path_retry in multipath.conf, or the transport timeouts."
    return 1
}

real=$(readlink -f "$dev" 2>/dev/null || echo "$dev")
name=${real##*/}
info=""
if [ -d "/sys/block/$name/dm" ] && ! command -v dmsetup >/dev/null 2>&1; then
    warn "$dev is a device-mapper node and dmsetup is not installed: cannot check its multipath queueing"
    [ "$override" = 1 ] || { warn "$dev: not mounted. (-o x-cetrafs.mpath-queue-ok overrides.)"; exit 32; }
fi
command -v dmsetup >/dev/null 2>&1 && info=$(dmsetup info -c --noheadings -o uuid,name --separator '|' "$real" 2>/dev/null || true)
case "$info" in
mpath-*)
    map=${info#*|}
    if ! mpath_check "$map"; then
        if [ "$override" = 1 ]; then
            warn "$dev: mounting anyway (x-cetrafs.mpath-queue-ok): only hardware fencing keeps this node's"
            warn "  queued writes off blocks its peers own after it is fenced"
        else
            warn "$dev: not mounted. (-o x-cetrafs.mpath-queue-ok overrides, for a hardware-fenced cluster.)"
            exit 32
        fi
    fi
    ;;
*)
    # Not a multipath map: a single path, or anything else. A SCSI disk
    # (or a partition of one) holds a write for its transport's time.
    d=$name
    [ -e "$SYS/block/$d/device" ] || d=$(basename "$(dirname "$(readlink -f "$SYS/class/block/$name" 2>/dev/null)")" 2>/dev/null || echo "")
    if [ -n "$d" ] && [ -e "$SYS/block/$d/device" ]; then
        path_hold "$d"
        if [ "$hold" -gt "$lease" ]; then
            warn "$dev holds a write for up to ${hold}s ($why) before failing it, longer than this node's"
            warn "  lease (${lease}s): after a path outage it can reach the array once a peer has taken over"
            warn "  the blocks it was aimed at. Lower the transport timeouts (iSCSI replacement_timeout, FC"
            warn "  fast_io_fail_tmo) so the sum is under ${lease}s, or use multipath with no_path_retry fail."
            if [ "$override" = 1 ]; then
                warn "$dev: mounting anyway (x-cetrafs.queue-ok): only hardware fencing keeps this node's late"
                warn "  writes off blocks its peers own after it is fenced"
            else
                warn "$dev: not mounted. (-o x-cetrafs.queue-ok overrides, for a hardware-fenced cluster.)"
                exit 32
            fi
        fi
    fi
    ;;
esac

# shellcheck disable=SC2086 # $args is a list of single-word flags
exec mount -i -t cetrafs $args ${kept:+-o "$kept"} "$dev" "$dir"
