# python caches
__pycache__/
# built Debian packages (make deb)
/dist/
# debhelper droppings from `make deb` (removed by `make deb-clean`).
# Scoped deliberately -- NOT /debian/*/, which would also swallow the
# tracked debian/source/. The staging dirs are named after the binary
# packages in debian/control.
/debian/.debhelper/
/debian/cetrafs-dkms/
/debian/cetrafs-tools/
/debian/files
/debian/debhelper-build-stamp
/debian/*.substvars
/debian/*.debhelper
/debian/*.debhelper.log

# ctest embeds the C helper sources (see ctest/embed.go); the copies in
# ctest/embedded/ are generated by `make -C ctest embed`, never committed.
/ctest/embedded/*
!/ctest/embedded/.gitkeep

/release-matrix-*

